<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.example</groupId>
        <artifactId>Movie_Ticket_Management</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>movie-core</artifactId>

    <packaging>jar</packaging>

    <dependencies>

        <!-- Apache Thrift Java Runtime -->
        <dependency>
            <groupId>org.apache.thrift</groupId>
            <artifactId>libthrift</artifactId>
            <version>0.19.0</version>
        </dependency>
        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
            <version>1.3.2</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.17</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- 1. Create the generated-source directory -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>

                <executions>
                    <execution>
                        <id>create-thrift-directory</id>
                        <phase>generate-sources</phase>

                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/generated-sources/thrift"/>
                            </target>
                        </configuration>

                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>


            <!-- 2. Run the Thrift compiler -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>

                <executions>
                    <execution>
                        <id>generate-thrift-sources</id>
                        <phase>generate-sources</phase>

                        <goals>
                            <goal>exec</goal>
                        </goals>

                        <configuration>

                            <executable>thrift</executable>

                            <arguments>

                                <!-- Thrift Java generator -->
                                <argument>--gen</argument>
                                <argument>java</argument>

                                <!-- Output directory -->
                                <argument>-out</argument>
                                <argument>
                                    ${project.build.directory}/generated-sources/thrift
                                </argument>

                                <!-- Input file -->
                                <argument>
                                    ${project.basedir}/src/main/thrift/theater.thrift
                                </argument>

                            </arguments>

                        </configuration>
                    </execution>
                </executions>
            </plugin>


            <!-- 3. Add generated Java files to Maven -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>

                <executions>
                    <execution>
                        <id>add-thrift-sources</id>
                        <phase>generate-sources</phase>

                        <goals>
                            <goal>add-source</goal>
                        </goals>

                        <configuration>
                            <sources>
                                <source>
                                    ${project.build.directory}/generated-sources/thrift
                                </source>
                            </sources>
                        </configuration>

                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>